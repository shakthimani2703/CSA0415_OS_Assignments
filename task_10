#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <unistd.h>
#include <sys/wait.h>
#include <pthread.h>

#define N 1000
static void *thread_fn(void *arg) { (void)arg; return NULL; }

static double seconds(struct timespec a, struct timespec b) {
    return (b.tv_sec-a.tv_sec) + (b.tv_nsec-a.tv_nsec)/1e9;
}

int main(void) {
    struct timespec a, b;
    clock_gettime(CLOCK_MONOTONIC, &a);
    for (int i=0; i<N; i++) {
        pid_t p=fork();
        if (p<0) { perror("fork"); return 1; }
        if (p==0) _exit(0);
        if (waitpid(p, NULL, 0)<0) { perror("waitpid"); return 1; }
    }
    clock_gettime(CLOCK_MONOTONIC, &b);
    printf("1000 fork+wait children: %.6f seconds\n", seconds(a,b));

    pthread_t t[N];
    clock_gettime(CLOCK_MONOTONIC, &a);
    for (int i=0; i<N; i++)
        if (pthread_create(&t[i], NULL, thread_fn, NULL)!=0) {
            perror("pthread_create"); return 1;
        }
    for (int i=0; i<N; i++)
        pthread_join(t[i], NULL);
    clock_gettime(CLOCK_MONOTONIC, &b);
    printf("1000 threads create+join: %.6f seconds\n", seconds(a,b));
    return 0;
}
